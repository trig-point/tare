{
  "name": "tare",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "node --test scripts/*.test.mts && pnpm -r test",
    "generate": "pnpm --filter @tare/engine generate",
    "hygiene": "node scripts/check-hygiene.mts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "@types/node": "^22.0.0",
    "typescript": "5.8.3"
  }
}
