{
  "name": "@tare/engine",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env src/index.ts",
    "import": "node --env-file-if-exists=../../.env scripts/import.mts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "generate": "node scripts/generate.mts && biome check --write --no-errors-on-unmatched src/queries"
  },
  "dependencies": {
    "@hono/mcp": "0.3.5",
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tare/nutrition": "workspace:*",
    "better-sqlite3": "13.0.3",
    "croner": "11.0.0",
    "hono": "4.13.14",
    "jose": "6.2.14",
    "rate-limiter-flexible": "11.2.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "typesql-cli": "0.24.0"
  }
}
