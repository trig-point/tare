{
  "$schema": "https://biomejs.dev/schemas/2.0.6/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "ignoreUnknown": true },
  "formatter": { "enabled": true, "indentStyle": "space" },
  "linter": { "enabled": true, "rules": { "recommended": true } },
  "overrides": [
    {
      "includes": ["packages/engine/src/queries/**/*.ts"],
      "linter": { "rules": { "suspicious": { "noExplicitAny": "off" } } }
    },
    {
      "includes": ["packages/engine/src/photo/**"],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "error" },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "node:fs": "Photo uploads stay in memory.",
                  "node:fs/promises": "Photo uploads stay in memory.",
                  "fs": "Photo uploads stay in memory.",
                  "fs/promises": "Photo uploads stay in memory."
                }
              }
            }
          }
        }
      }
    }
  ]
}
